---
// src/components/HowItWorks.astro

// These are the three "steps" in your "How It Works" section:
export interface FlowItem {
  title: string;
  description: string;
  cardTitle: string;
  cardTagline: string;
}

interface Props {
  items?: FlowItem[];
  startAngle?: number; // in degrees, 0 = to the right, 90 = up, etc.
  radius?: number; // the radius of the central ring (in px)
  width?: number; // total width/height of the SVG (in px)
  onHighlight?: (index: number) => void;
}

const { items = [], startAngle = -90, radius = 150, width = 400 } = Astro.props;

const height = width;
const serializedItems = JSON.stringify(items);
const serializedProps = JSON.stringify({ radius, width, height });
---

<!-- Import D3.js from CDN -->
<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<div class="flow-diagram-container">
  <div id="flow-diagram-root"></div>
</div>

<script define:vars={{ serializedItems, serializedProps, startAngle }}>
  document.addEventListener('DOMContentLoaded', () => {
    const items = JSON.parse(serializedItems);
    const { radius, width, height } = JSON.parse(serializedProps);

    if (!items || items.length === 0) return;

    // Get CSS variables for colors
    const style = getComputedStyle(document.documentElement);
    const primaryColor = style.getPropertyValue('--aw-color-primary').trim();
    const secondaryColor = style.getPropertyValue('--aw-color-secondary').trim();
    const textColor = style.getPropertyValue('--aw-color-text-default').trim();
    const mutedColor = style.getPropertyValue('--aw-color-text-muted').trim();
    const bgColor = style.getPropertyValue('--aw-color-bg-page').trim();
    const bgDarkColor = style.getPropertyValue('--aw-color-bg-page-dark').trim();

    // Calculate dimensions with safety margins
    const margin = width * 0.15; // 15% margin for safety
    const effectiveWidth = width - margin * 2;
    const effectiveHeight = height - margin * 2;

    // Calculate the effective radius to ensure boxes fit
    const effectiveRadius = Math.min(radius, effectiveWidth * 0.35); // 35% of effective width

    // Center points including margin
    const cx = width / 2;
    const cy = height / 2;

    // Box dimensions proportional to effective radius
    const boxWidth = Math.min(effectiveRadius * 1.2, 160); // 120% of radius, max 160px
    const boxHeight = Math.min(effectiveRadius * 0.8, 100); // 80% of radius, max 100px
    const boxPadding = 12;

    // Calculate angle step
    const angleStep = (2 * Math.PI) / items.length;
    const startRad = (startAngle * Math.PI) / 180;

    // Create SVG element
    const svg = d3
      .select('#flow-diagram-root')
      .append('svg')
      .attr('viewBox', `0 0 ${width} ${height}`)
      .attr('width', '100%')
      .attr('height', '100%')
      .style('background', 'transparent');

    // Add definitions for filters
    const defs = svg.append('defs');
    const filter = defs.append('filter').attr('id', 'dropShadow').attr('height', '150%');

    filter.append('feGaussianBlur').attr('in', 'SourceAlpha').attr('stdDeviation', 2);

    filter.append('feOffset').attr('dx', 0).attr('dy', 2);

    const feMerge = filter.append('feMerge');
    feMerge.append('feMergeNode');
    feMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    // Draw the central ring
    svg
      .append('circle')
      .attr('cx', cx)
      .attr('cy', cy)
      .attr('r', effectiveRadius)
      .attr('fill', 'none')
      .attr('stroke', primaryColor)
      .attr('stroke-width', effectiveRadius * 0.1) // 10% of radius
      .attr('opacity', 0.3);

    // Create and position the items
    items.forEach((item, index) => {
      const angle = startRad + index * angleStep;
      const nodeX = cx + effectiveRadius * Math.cos(angle);
      const nodeY = cy + effectiveRadius * Math.sin(angle);

      // Add connection dot
      svg
        .append('circle')
        .attr('cx', nodeX)
        .attr('cy', nodeY)
        .attr('r', effectiveRadius * 0.03) // 3% of radius
        .attr('fill', primaryColor)
        .attr('opacity', 0.8)
        .attr('class', `connector-dot connector-${index}`);

      // Calculate callout position
      const calloutDistance = effectiveRadius * 0.4; // 40% of radius
      const calloutX = cx + (effectiveRadius + calloutDistance) * Math.cos(angle);
      const calloutY = cy + (effectiveRadius + calloutDistance) * Math.sin(angle);

      // Add connector line
      svg
        .append('line')
        .attr('x1', nodeX)
        .attr('y1', nodeY)
        .attr('x2', calloutX)
        .attr('y2', calloutY)
        .attr('stroke', primaryColor)
        .attr('stroke-width', effectiveRadius * 0.01) // 1% of radius
        .attr('opacity', 0.7)
        .attr('class', `connector-line connector-${index}`);

      // Calculate box position
      const ux = Math.cos(angle);
      const uy = Math.sin(angle);
      const nudge = effectiveRadius * 0.2; // 20% of radius

      const group = svg
        .append('g')
        .attr('class', `item-group item-${index}`)
        .attr(
          'transform',
          `translate(${calloutX + ux * nudge - boxWidth / 2}, ${calloutY + uy * nudge - boxHeight / 2})`
        );

      // Add box background
      group
        .append('rect')
        .attr('width', boxWidth)
        .attr('height', boxHeight)
        .attr('fill', bgColor)
        .attr('stroke', mutedColor)
        .attr('stroke-width', 1)
        .attr('rx', 6)
        .attr('filter', 'url(#dropShadow)');

      // Create text wrapper
      const textWrapper = group.append('g').attr('transform', `translate(${boxPadding}, ${boxPadding})`);

      // Add step number
      textWrapper
        .append('text')
        .attr('dy', '1em')
        .attr('font-family', 'var(--aw-font-sans)')
        .attr('font-size', '14px')
        .attr('font-weight', '600')
        .attr('fill', primaryColor)
        .text(`Step ${index + 1}`);

      // Add tagline
      textWrapper
        .append('text')
        .attr('dy', '2.5em')
        .attr('font-family', 'var(--aw-font-sans)')
        .attr('font-size', '12px')
        .attr('font-weight', '500')
        .attr('fill', primaryColor)
        .text(item.cardTagline);

      // Add title
      textWrapper
        .append('text')
        .attr('dy', '4em')
        .attr('font-family', 'var(--aw-font-heading)')
        .attr('font-size', '16px')
        .attr('font-weight', '600')
        .attr('fill', textColor)
        .text(item.cardTitle);
    });

    // Add hover effects
    const itemGroups = svg.selectAll('.item-group');

    function activateItem(index) {
      // Reset all items
      itemGroups.attr('transform-origin', 'center').attr('transform', function () {
        return this.getAttribute('transform').split(' scale')[0];
      });

      svg
        .selectAll('.connector-dot')
        .attr('r', effectiveRadius * 0.03)
        .attr('opacity', 0.8);
      svg.selectAll('.connector-line').attr('opacity', 0.7);

      // Highlight selected item
      const group = d3.select(`.item-${index}`);
      group
        .transition()
        .duration(200)
        .attr('transform', function () {
          const current = this.getAttribute('transform').split(' scale')[0];
          return current + ' scale(1.05)';
        });

      svg
        .selectAll(`.connector-${index}`)
        .filter('.connector-dot')
        .transition()
        .duration(200)
        .attr('r', effectiveRadius * 0.04)
        .attr('opacity', 1);

      svg.selectAll(`.connector-${index}`).filter('.connector-line').transition().duration(200).attr('opacity', 1);

      // Dispatch highlight event
      document.dispatchEvent(
        new CustomEvent('flowHighlight', {
          detail: { index },
          bubbles: true,
        })
      );
    }

    // Setup automatic rotation
    function rotateHighlight() {
      let currentIndex = 0;

      function highlight() {
        activateItem(currentIndex);
        currentIndex = (currentIndex + 1) % items.length;
      }

      highlight(); // Initial highlight
      return setInterval(highlight, 3000);
    }

    // Start rotation
    const rotationInterval = rotateHighlight();

    // Cleanup on page leave
    window.addEventListener('unload', () => {
      clearInterval(rotationInterval);
    });
  });
</script>

<style>
  .flow-diagram-container {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
  }

  #flow-diagram-root {
    width: 100%;
    height: 100%;
  }

  :global(.dark) .flow-diagram-container svg rect {
    fill: var(--aw-color-bg-page-dark);
  }

  :global(.dark) .flow-diagram-container svg text {
    fill: var(--aw-color-text-default);
  }
</style>
