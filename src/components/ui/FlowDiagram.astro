---
// src/components/HowItWorks.astro

// These are the three "steps" in your "How It Works" section:
export interface FlowItem {
  title: string;
  description: string;
  cardTitle: string;
  cardTagline: string;
}

interface Props {
  items?: FlowItem[];
  startAngle?: number; // in degrees, 0 = to the right, 90 = up, etc.
  radius?: number; // the radius of the central ring (in px)
  width?: number; // total width/height of the SVG (in px)
  onHighlight?: (index: number) => void;
}

const { items = [], startAngle = -90, radius = 150, width = 400 } = Astro.props;

const height = width;
const serializedItems = JSON.stringify(items);
const serializedProps = JSON.stringify({ radius, width, height });
---

<!-- Import D3.js from CDN -->
<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<div class="flow-diagram-container">
  <div id="flow-diagram-root"></div>
</div>

<script define:vars={{ serializedItems, serializedProps, startAngle }}>
  document.addEventListener('DOMContentLoaded', () => {
    const items = JSON.parse(serializedItems);
    const { radius, width, height } = JSON.parse(serializedProps);

    if (!items || items.length === 0) return;

    // Get CSS variables for colors
    const style = getComputedStyle(document.documentElement);
    const primaryColor = style.getPropertyValue('--aw-color-primary').trim();
    const secondaryColor = style.getPropertyValue('--aw-color-secondary').trim();
    const textColor = style.getPropertyValue('--aw-color-text-default').trim();
    const mutedColor = style.getPropertyValue('--aw-color-text-muted').trim();
    const bgColor = style.getPropertyValue('--aw-color-bg-page').trim();
    const bgDarkColor = style.getPropertyValue('--aw-color-bg-page-dark').trim();

    // Calculate dimensions with safety margins
    const margin = width * 0.15; // 15% margin for safety
    const effectiveWidth = width - margin * 2;
    const effectiveHeight = height - margin * 2;

    // Calculate the effective radius to ensure boxes fit
    const effectiveRadius = Math.min(radius, effectiveWidth * 0.35); // 35% of effective width

    // Center points including margin
    const cx = width / 2;
    const cy = height / 2;

    // Calculate dimensions for all cards first
    const calculateTextDimensions = (text, maxCharsPerLine = 22) => {
      const words = text.split(' ');
      const lines = [];
      let currentLine = '';

      words.forEach((word) => {
        if ((currentLine + ' ' + word).length <= maxCharsPerLine) {
          currentLine = currentLine ? `${currentLine} ${word}` : word;
        } else {
          if (currentLine) lines.push(currentLine);
          currentLine = word;
        }
      });
      if (currentLine) lines.push(currentLine);

      return {
        lines,
        lineCount: lines.length,
        maxLineWidth: Math.max(...lines.map((line) => line.length)),
      };
    };

    // Set minimum padding and spacing
    const minPadding = Math.max(effectiveRadius * 0.08, 24); // Minimum 24px or 8% of radius
    const boxPadding = minPadding;
    const elementSpacing = Math.max(effectiveRadius * 0.04, 12); // Minimum 12px or 4% of radius

    // Calculate maximum dimensions needed for all cards
    const cardDimensions = items.map((item) => {
      const taglineDims = calculateTextDimensions(item.cardTagline);
      const titleDims = calculateTextDimensions(item.cardTitle);

      // Calculate minimum width needed (1 character ≈ 12px for better readability)
      const minWidth = Math.max(taglineDims.maxLineWidth * 12, titleDims.maxLineWidth * 12, effectiveRadius * 0.8);

      // Calculate minimum height needed
      const minHeight = Math.max(
        boxPadding * 2 + // top and bottom padding
          elementSpacing + // top spacing
          24 + // step number height
          elementSpacing + // spacing after step number
          20 + // title height
          elementSpacing + // spacing after title
          taglineDims.lineCount * 20 + // tagline height (20px per line)
          (taglineDims.lineCount - 1) * (elementSpacing / 2) + // spacing between tagline lines
          elementSpacing, // bottom spacing
        effectiveRadius * 0.6
      );

      return { width: minWidth, height: minHeight };
    });

    // Use the maximum dimensions for all cards (add padding)
    const boxWidth = Math.min(
      Math.max(...cardDimensions.map((d) => d.width)) + boxPadding * 2,
      effectiveRadius * 1.6 // Increased from 1.4 to 1.6 for better text containment
    );

    const boxHeight = Math.min(
      Math.max(...cardDimensions.map((d) => d.height)) + boxPadding * 2,
      effectiveRadius * 1.2 // Increased from 1.0 to 1.2 for better text containment
    );

    // Calculate text dimensions for centering
    const textWidth = boxWidth - boxPadding * 2;
    const textAreaHeight = boxHeight - boxPadding * 2;

    // Make text sizes proportional to available text area
    const stepNumberHeight = Math.min(Math.max(textAreaHeight * 0.12, 16), 24); // Added upper limit
    const titleHeight = Math.min(Math.max(textAreaHeight * 0.14, 16), 20); // Added upper limit
    const taglineHeight = Math.min(Math.max(textAreaHeight * 0.14, 14), 18); // Added upper limit

    // Create SVG element
    const svg = d3
      .select('#flow-diagram-root')
      .append('svg')
      .attr('viewBox', `0 0 ${width} ${height}`)
      .attr('width', '100%')
      .attr('height', '100%')
      .style('background', 'transparent');

    // Add definitions for filters
    const defs = svg.append('defs');
    const filter = defs.append('filter').attr('id', 'dropShadow').attr('height', '150%');

    filter.append('feGaussianBlur').attr('in', 'SourceAlpha').attr('stdDeviation', 2);

    filter.append('feOffset').attr('dx', 0).attr('dy', 2);

    const feMerge = filter.append('feMerge');
    feMerge.append('feMergeNode');
    feMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    // Draw the central ring
    svg
      .append('circle')
      .attr('cx', cx)
      .attr('cy', cy)
      .attr('r', effectiveRadius)
      .attr('fill', 'none')
      .attr('stroke', primaryColor)
      .attr('stroke-width', effectiveRadius * 0.1) // 10% of radius
      .attr('opacity', 0.3);

    // Function to create sector path
    function createSectorPath(startAngle, endAngle, innerRadius, outerRadius) {
      const start = {
        x: cx + Math.cos(startAngle) * outerRadius,
        y: cy + Math.sin(startAngle) * outerRadius,
      };
      const end = {
        x: cx + Math.cos(endAngle) * outerRadius,
        y: cy + Math.sin(endAngle) * outerRadius,
      };
      const innerStart = {
        x: cx + Math.cos(startAngle) * innerRadius,
        y: cy + Math.sin(startAngle) * innerRadius,
      };
      const innerEnd = {
        x: cx + Math.cos(endAngle) * innerRadius,
        y: cy + Math.sin(endAngle) * innerRadius,
      };

      const largeArcFlag = endAngle - startAngle <= Math.PI ? 0 : 1;

      return `
        M ${start.x} ${start.y}
        A ${outerRadius} ${outerRadius} 0 ${largeArcFlag} 1 ${end.x} ${end.y}
        L ${innerEnd.x} ${innerEnd.y}
        A ${innerRadius} ${innerRadius} 0 ${largeArcFlag} 0 ${innerStart.x} ${innerStart.y}
        Z
      `;
    }

    // Create sectors group
    const sectorsGroup = svg.append('g').attr('class', 'sectors-group');

    // Calculate sector angles
    const sectorAngle = (2 * Math.PI) / items.length;
    const innerRadius = effectiveRadius * 0.45;
    const outerRadius = effectiveRadius * 0.55;

    // Create single animated sector
    const animatedSector = sectorsGroup
      .append('path')
      .attr('class', 'animated-sector')
      .attr('fill', primaryColor)
      .attr('opacity', 0.3)
      .attr('stroke', 'none');

    // Function to interpolate between angles
    function interpolateAngles(startAngle1, endAngle1, startAngle2, endAngle2) {
      // Ensure angles are in the same phase
      while (startAngle2 < startAngle1) startAngle2 += 2 * Math.PI;
      while (endAngle2 < endAngle1) endAngle2 += 2 * Math.PI;

      // Choose shortest path
      if (startAngle2 - startAngle1 > 2 * Math.PI) {
        startAngle2 -= 2 * Math.PI;
        endAngle2 -= 2 * Math.PI;
      }

      return function (t) {
        const currentStartAngle = startAngle1 + (startAngle2 - startAngle1) * t;
        const currentEndAngle = endAngle1 + (endAngle2 - endAngle1) * t;
        return createSectorPath(currentStartAngle, currentEndAngle, innerRadius, outerRadius);
      };
    }

    // Function to activate sector with smooth animation
    function activateSector(index, previousIndex) {
      const pivotAngle = (startAngle * Math.PI) / 110;
      const currentStartAngle = pivotAngle + index * sectorAngle;
      const currentEndAngle = currentStartAngle + sectorAngle;

      const previousStartAngle = pivotAngle + previousIndex * sectorAngle;
      const previousEndAngle = previousStartAngle + sectorAngle;

      animatedSector
        .transition()
        .duration(800)
        .ease(d3.easeCubicInOut)
        .attrTween('d', function () {
          return interpolateAngles(previousStartAngle, previousEndAngle, currentStartAngle, currentEndAngle);
        });
    }

    let currentIndex = 0;

    // Modify existing activateItem function to include smooth sector animation
    function activateItem(index) {
      // Reset all items with smooth transition
      itemGroups
        .transition()
        .duration(400)
        .ease(d3.easeCubicOut)
        .attr('transform', function () {
          return this.getAttribute('transform').split(' scale')[0];
        });

      svg
        .selectAll('.connector-dot')
        .transition()
        .duration(400)
        .ease(d3.easeCubicOut)
        .attr('r', effectiveRadius * 0.03)
        .attr('opacity', 0.8);

      svg
        .selectAll('.connector-line')
        .transition()
        .duration(400)
        .ease(d3.easeCubicOut)
        .attr('opacity', 0.7)
        .attr('stroke-width', effectiveRadius * 0.01);

      // Activate corresponding sector with smooth animation
      const previousIndex = currentIndex;
      currentIndex = index;
      activateSector(index, previousIndex);

      // Highlight selected item with enhanced animation
      const group = d3.select(`.item-${index}`);
      group
        .transition()
        .duration(600)
        .ease(d3.easeCubicOut)
        .attr('transform', function () {
          const current = this.getAttribute('transform').split(' scale')[0];
          return current + ' scale(1.05)';
        });

      // Enhance dot animation
      svg
        .selectAll(`.connector-${index}`)
        .filter('.connector-dot')
        .transition()
        .duration(600)
        .ease(d3.easeCubicOut)
        .attr('r', effectiveRadius * 0.04)
        .attr('opacity', 1);

      // Enhance line animation
      svg
        .selectAll(`.connector-${index}`)
        .filter('.connector-line')
        .transition()
        .duration(600)
        .ease(d3.easeCubicOut)
        .attr('opacity', 1)
        .attr('stroke-width', effectiveRadius * 0.015);

      // Dispatch highlight event
      document.dispatchEvent(
        new CustomEvent('flowHighlight', {
          detail: { index },
          bubbles: true,
        })
      );
    }

    // Create and position the items
    items.forEach((item, index) => {
      const angle = (startAngle * Math.PI) / 180 + (index * (2 * Math.PI)) / items.length;
      const nodeX = cx + effectiveRadius * Math.cos(angle);
      const nodeY = cy + effectiveRadius * Math.sin(angle);

      // Add connection dot
      svg
        .append('circle')
        .attr('cx', nodeX)
        .attr('cy', nodeY)
        .attr('r', effectiveRadius * 0.03) // 3% of radius
        .attr('fill', primaryColor)
        .attr('opacity', 0.8)
        .attr('class', `connector-dot connector-${index}`);

      // Calculate uniform distance for all boxes
      const boxDistance = effectiveRadius * 1.6; // Distancia uniforme desde el centro
      const boxX = cx + boxDistance * Math.cos(angle);
      const boxY = cy + boxDistance * Math.sin(angle);

      // Add connector line
      svg
        .append('line')
        .attr('x1', nodeX)
        .attr('y1', nodeY)
        .attr('x2', boxX)
        .attr('y2', boxY)
        .attr('stroke', primaryColor)
        .attr('stroke-width', effectiveRadius * 0.01)
        .attr('opacity', 0.7)
        .attr('class', `connector-line connector-${index}`);

      const group = svg
        .append('g')
        .attr('class', `item-group item-${index}`)
        .attr('transform', `translate(${boxX - boxWidth / 2}, ${boxY - boxHeight / 2})`);

      // Add box background with rounded corners and shadow
      group
        .append('rect')
        .attr('width', boxWidth)
        .attr('height', boxHeight)
        .attr('fill', bgColor)
        .attr('stroke', mutedColor)
        .attr('stroke-width', 1)
        .attr('rx', 8)
        .attr('filter', 'url(#dropShadow)');

      // Create text wrapper with flex-like centering
      const textWrapper = group
        .append('g')
        .attr('class', 'text-wrapper')
        .attr('transform', `translate(${boxPadding}, ${boxPadding})`);

      // Split tagline into lines
      const taglineLines = calculateTextDimensions(item.cardTagline).lines;

      // Calculate total content height
      const totalTextHeight =
        stepNumberHeight +
        elementSpacing +
        titleHeight +
        elementSpacing +
        taglineLines.length * taglineHeight +
        (taglineLines.length - 1) * (elementSpacing / 2);

      // Center vertically within available space
      const availableHeight = boxHeight - boxPadding * 2;
      const startY = (availableHeight - totalTextHeight) / 2;

      // Add step number
      textWrapper
        .append('text')
        .attr('y', startY)
        .attr('x', textWidth / 2)
        .attr('text-anchor', 'middle')
        .attr('dominant-baseline', 'hanging')
        .attr('font-family', 'var(--aw-font-sans)')
        .attr('font-size', `${stepNumberHeight}px`)
        .attr('font-weight', '500')
        .attr('fill', primaryColor)
        .attr('class', 'step-number')
        .text(`Step ${index + 1}`);

      // Add title with adjusted position
      textWrapper
        .append('text')
        .attr('y', startY + stepNumberHeight + elementSpacing)
        .attr('x', textWidth / 2)
        .attr('text-anchor', 'middle')
        .attr('dominant-baseline', 'hanging')
        .attr('font-family', 'var(--aw-font-sans)')
        .attr('font-size', `${titleHeight}px`)
        .attr('font-weight', '500')
        .attr('fill', primaryColor)
        .attr('class', 'title')
        .text(item.cardTitle);

      // Add tagline with multiple lines and adjusted spacing
      taglineLines.forEach((line, lineIndex) => {
        textWrapper
          .append('text')
          .attr(
            'y',
            startY +
              stepNumberHeight +
              elementSpacing +
              titleHeight +
              elementSpacing +
              lineIndex * (taglineHeight + elementSpacing / 2)
          )
          .attr('x', textWidth / 2)
          .attr('text-anchor', 'middle')
          .attr('dominant-baseline', 'hanging')
          .attr('font-family', 'var(--aw-font-heading)')
          .attr('font-size', `${taglineHeight}px`)
          .attr('font-weight', '300')
          .attr('fill', textColor)
          .attr('class', 'tagline')
          .text(line);
      });
    });

    // Add hover effects
    const itemGroups = svg.selectAll('.item-group');

    // Setup automatic rotation
    function rotateHighlight() {
      let currentIndex = 0;

      function highlight() {
        activateItem(currentIndex);
        currentIndex = (currentIndex + 1) % items.length;
      }

      highlight(); // Initial highlight
      return setInterval(highlight, 3000);
    }

    // Start rotation
    const rotationInterval = rotateHighlight();

    // Cleanup on page leave
    window.addEventListener('unload', () => {
      clearInterval(rotationInterval);
    });
  });
</script>

<style>
  .flow-diagram-container {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
  }

  #flow-diagram-root {
    width: 100%;
    height: 100%;
  }

  :global(.dark) .flow-diagram-container svg rect {
    fill: var(--aw-color-bg-page-dark);
  }

  :global(.dark) .flow-diagram-container svg text {
    fill: var(--aw-color-text-default);
  }
</style>
