---
// src/components/HowItWorks.astro

// These are the three "steps" in your "How It Works" section:
export interface FlowItem {
  title: string;
  description: string;
}

interface Props {
  items?: FlowItem[];
  startAngle?: number; // in degrees, 0 = to the right, 90 = up, etc.
  radius?: number; // the radius of the central ring (in px)
  width?: number; // total width/height of the SVG (in px)
}

const {
  items = [
    {
      title: 'Extract',
      description: 'Meaningful information from unstructured data',
    },
    {
      title: 'Automate',
      description: 'Automate your business process, applying rules and validations',
    },
    {
      title: 'Export',
      description: 'Present the right data into your ERP, CRM or IT Tool',
    },
  ],
  startAngle = -90, // start at "12 o'clock"
  radius = 150, // px
  width = 400, // px (so SVG is 400×400)
} = Astro.props;

const height = width;
const serializedItems = JSON.stringify(items);
---

<!-- Import D3.js from CDN -->
<script is:inline src="https://d3js.org/d3.v7.min.js"></script>

<div class="flow-diagram-container" style={`width: ${width}px; height: ${height}px;`}>
  <div id="flow-diagram-root"></div>
</div>

<script define:vars={{ serializedItems, startAngle, radius, width, height }}>
  // Ensure we only run this once the DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    const items = JSON.parse(serializedItems);

    // Center of our SVG
    const cx = width / 2;
    const cy = height / 2;

    // Calculate angle step
    const angleStep = (2 * Math.PI) / items.length;
    const startRad = (startAngle * Math.PI) / 180;

    // Create SVG element
    const svg = d3
      .select('#flow-diagram-root')
      .append('svg')
      .attr('width', width)
      .attr('height', height)
      .attr('viewBox', `0 0 ${width} ${height}`)
      .style('background', 'transparent');

    // Add definitions for filters
    const defs = svg.append('defs');
    const filter = defs.append('filter').attr('id', 'dropShadow').attr('height', '150%');

    filter.append('feGaussianBlur').attr('in', 'SourceAlpha').attr('stdDeviation', 2);

    filter.append('feOffset').attr('dx', 0).attr('dy', 2);

    const feMerge = filter.append('feMerge');
    feMerge.append('feMergeNode');
    feMerge.append('feMergeNode').attr('in', 'SourceGraphic');

    // Draw the central ring
    svg
      .append('circle')
      .attr('cx', cx)
      .attr('cy', cy)
      .attr('r', radius)
      .attr('fill', 'none')
      .attr('stroke', '#4CB5AD')
      .attr('stroke-width', 20)
      .attr('opacity', 0.3);

    // Create and position the items
    items.forEach((item, index) => {
      const angle = startRad + index * angleStep;
      const nodeX = cx + radius * Math.cos(angle);
      const nodeY = cy + radius * Math.sin(angle);

      // Add connection dot
      svg
        .append('circle')
        .attr('cx', nodeX)
        .attr('cy', nodeY)
        .attr('r', 6)
        .attr('fill', '#4CB5AD')
        .attr('opacity', 0.8)
        .attr('class', 'connector-dot');

      // Calculate callout position
      const calloutDistance = 40;
      const calloutX = cx + (radius + calloutDistance) * Math.cos(angle);
      const calloutY = cy + (radius + calloutDistance) * Math.sin(angle);

      // Add connector line
      svg
        .append('line')
        .attr('x1', nodeX)
        .attr('y1', nodeY)
        .attr('x2', calloutX)
        .attr('y2', calloutY)
        .attr('stroke', '#4CB5AD')
        .attr('stroke-width', 2)
        .attr('opacity', 0.7)
        .attr('class', 'connector-line');

      // Create text box
      const boxWidth = 160;
      const boxHeight = 90;
      const boxPadding = 15;

      // Calculate box position to avoid overlaps
      const ux = Math.cos(angle);
      const uy = Math.sin(angle);
      const nudge = Math.sqrt((boxWidth / 2) ** 2 + (boxHeight / 2) ** 2) * 0.7;

      const group = svg
        .append('g')
        .attr('class', 'item-group')
        .attr(
          'transform',
          `translate(${calloutX + ux * nudge - boxWidth / 2}, ${calloutY + uy * nudge - boxHeight / 2})`
        );

      // Add box background
      group
        .append('rect')
        .attr('width', boxWidth)
        .attr('height', boxHeight)
        .attr('fill', 'white')
        .attr('stroke', '#273233')
        .attr('stroke-width', 1.5)
        .attr('rx', 8)
        .attr('filter', 'url(#dropShadow)');

      // Add title
      group
        .append('text')
        .attr('x', boxPadding)
        .attr('y', boxPadding + 12)
        .text(item.title)
        .attr('font-family', 'Inter, system-ui, sans-serif')
        .attr('font-size', '18px')
        .attr('font-weight', '600')
        .attr('fill', '#273233');

      // Add description with word wrap
      const words = item.description.split(' ');
      let line = '';
      let lineNumber = 0;
      const lineHeight = 20;
      const y = boxPadding + 40;

      words.forEach((word) => {
        const testLine = line + word + ' ';
        if (testLine.length * 7 > boxWidth - boxPadding * 2) {
          group
            .append('text')
            .attr('x', boxPadding)
            .attr('y', y + lineNumber * lineHeight)
            .text(line)
            .attr('font-family', 'Inter, system-ui, sans-serif')
            .attr('font-size', '14px')
            .attr('fill', '#4A4A4A');
          line = word + ' ';
          lineNumber++;
        } else {
          line = testLine;
        }
      });

      group
        .append('text')
        .attr('x', boxPadding)
        .attr('y', y + lineNumber * lineHeight)
        .text(line)
        .attr('font-family', 'Inter, system-ui, sans-serif')
        .attr('font-size', '14px')
        .attr('fill', '#4A4A4A');
    });

    // Add hover effects
    const itemGroups = svg.selectAll('.item-group');

    function activateItem(group, index) {
      // Reset all items
      itemGroups.attr('transform-origin', 'center').attr('transform', function () {
        return this.getAttribute('transform');
      });

      svg.selectAll('.connector-dot').attr('r', 6).attr('opacity', 0.8);
      svg.selectAll('.connector-line').attr('opacity', 0.7);

      // Highlight selected item
      group
        .transition()
        .duration(200)
        .attr('transform', function () {
          const current = this.getAttribute('transform');
          return current + ' scale(1.05)';
        });

      svg
        .selectAll('.connector-dot')
        .filter((_, i) => i === index)
        .transition()
        .duration(200)
        .attr('r', 8)
        .attr('opacity', 1);

      svg
        .selectAll('.connector-line')
        .filter((_, i) => i === index)
        .transition()
        .duration(200)
        .attr('opacity', 1);
    }

    // Setup automatic rotation
    function rotateHighlight() {
      let currentIndex = 0;

      function highlight() {
        const group = d3.select(itemGroups.nodes()[currentIndex]);
        activateItem(group, currentIndex);
        currentIndex = (currentIndex + 1) % items.length;
      }

      highlight(); // Initial highlight
      return setInterval(highlight, 3000);
    }

    // Start rotation
    const rotationInterval = rotateHighlight();

    // Cleanup on page leave
    window.addEventListener('unload', () => {
      clearInterval(rotationInterval);
    });
  });
</script>

<style>
  .flow-diagram-container {
    position: relative;
    margin: 0 auto;
  }

  #flow-diagram-root {
    width: 100%;
    height: 100%;
  }

  :global(.dark) .flow-diagram-container svg rect {
    fill: #1e293b;
  }

  :global(.dark) .flow-diagram-container svg text {
    fill: #e2e8f0;
  }
</style>
