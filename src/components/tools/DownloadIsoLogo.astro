---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import isologoImage from '~/assets/tools/logos/iso.svg';

interface Props {
  class?: string;
}

interface ColorOption {
  value: string;
  label: string;
}

// Opciones de ancho predefinidas para el PNG
const widthOptions = [256, 512, 1024, 2048];

const logoColorOptions: ColorOption[] = [
  { value: '#f9f9f9', label: 'Blanco' },
  { value: '#1E2828', label: 'Negro' },
  { value: '#1C4B49', label: 'Verde Oscuro' },
  { value: '#1A6D69', label: 'Verde' },
  { value: '#57A09F', label: 'Verde Medio' },
  { value: '#93D3D4', label: 'Verde Agua' },
  { value: '#A6DBDC', label: 'Verde Claro' },
  { value: '#D6EEEF', label: 'Verde Muy Claro' },
  { value: '#E6F4F4', label: 'Verde Pálido' },
];

const { class: className } = Astro.props;
---

<div class:list={['relative flex flex-col p-6 bg-slate-800 rounded-lg shadow-lg border border-slate-700', className]}>
  <div class="flex items-center">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-10 h-10 text-blue-400"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      fill="none"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path d="M15 8h.01"></path>
      <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"></path>
      <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"></path>
      <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"></path>
    </svg>
    <h3 class="text-xl font-bold ml-4 text-white">Isologo Corporativo</h3>
  </div>

  <p class="mt-4 text-slate-300">Descarga el isologo oficial de la empresa en formato SVG o PNG.</p>

  <div class="mt-6 flex justify-center">
    <div id="iso-preview-container" class="relative w-48 h-48 rounded-lg p-4 transition-colors duration-300 bg-white/5">
      <Image
        src={isologoImage}
        alt="Isologo de la empresa"
        width={192}
        height={192}
        class="object-contain"
        id="iso-preview-image"
      />
    </div>
  </div>

  <!-- Color Selection -->
  <div class="space-y-4 mb-6">
    <div>
      <label for="iso-logoColor" class="block text-sm font-medium text-slate-300 mb-2">Color del Logo</label>
      <select id="iso-logoColor" class="w-full bg-slate-700 text-white rounded-lg px-4 py-2 border border-slate-600">
        {logoColorOptions.map((option) => <option value={option.value}>{option.label}</option>)}
      </select>
    </div>
    <div>
      <label for="iso-pngWidth" class="block text-sm font-medium text-slate-300 mb-2">Ancho del PNG (px)</label>
      <select id="iso-pngWidth" class="w-full bg-slate-700 text-white rounded-lg px-4 py-2 border border-slate-600">
        {widthOptions.map((width) => <option value={width}>{width}px</option>)}
      </select>
    </div>
  </div>

  <div class="flex flex-col space-y-4 mt-auto">
    <a
      href={isologoImage.src}
      download="isologo.svg"
      class="flex items-center justify-center px-4 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition duration-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 mr-2"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
        <path d="M7 11l5 5l5 -5"></path>
        <path d="M12 4l0 12"></path>
      </svg>
      Descargar SVG
    </a>

    <button
      id="iso-downloadPng"
      data-logo-url={isologoImage.src}
      class="flex items-center justify-center px-4 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition duration-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5 mr-2"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"></path>
        <path d="M7 11l5 5l5 -5"></path>
        <path d="M12 4l0 12"></path>
      </svg>
      Descargar PNG
    </button>
  </div>
</div>

<script>
  import { downloadAsPng } from '~/utils/download-as-png';

  // Set up event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const downloadPngButton = document.getElementById('iso-downloadPng');
    const logoColorSelect = document.getElementById('iso-logoColor') as HTMLSelectElement;
    const pngWidthSelect = document.getElementById('iso-pngWidth') as HTMLSelectElement;
    const previewContainer = document.getElementById('iso-preview-container');

    if (!downloadPngButton || !logoColorSelect || !pngWidthSelect || !previewContainer) {
      console.error('Required elements not found');
      return;
    }

    const logoUrl = downloadPngButton.getAttribute('data-logo-url');
    if (!logoUrl) {
      console.error('Logo URL not found');
      return;
    }

    // Function to update SVG colors
    const updateSvgColors = (svgElement: SVGElement) => {
      const logoElements = svgElement.getElementsByClassName('logo-part');

      // Update logo color
      Array.from(logoElements).forEach((element) => {
        (element as SVGElement).style.fill = logoColorSelect.value;
      });
    };

    // Function to update preview
    const updatePreview = async () => {
      try {
        // Fetch the SVG
        const response = await fetch(logoUrl);
        const svgText = await response.text();

        // Create a temporary container for the SVG
        const container = document.createElement('div');
        container.innerHTML = svgText;
        const svgElement = container.querySelector('svg');

        if (!svgElement) {
          throw new Error('SVG element not found');
        }

        // Update colors
        updateSvgColors(svgElement);

        // Update the preview container with the modified SVG
        previewContainer.innerHTML = svgElement.outerHTML;

        // Adjust the SVG to fit the container
        const previewSvg = previewContainer.querySelector('svg');
        if (previewSvg) {
          previewSvg.style.width = '100%';
          previewSvg.style.height = '100%';
        }

        // Update preview container background based on logo color
        const isLogoWhite = logoColorSelect.value === '#f9f9f9';
        previewContainer.style.backgroundColor = isLogoWhite ? 'rgba(255, 255, 255, 0.05)' : 'rgb(255, 255, 255)';
      } catch (error) {
        console.error('Error updating preview:', error);
      }
    };

    // Update preview when colors change
    logoColorSelect.addEventListener('change', updatePreview);

    // Initial preview update
    updatePreview();

    // Handle PNG download
    downloadPngButton.addEventListener('click', async () => {
      try {
        const width = parseInt(pngWidthSelect.value);
        const svgElement = previewContainer.querySelector('svg');

        if (!svgElement) {
          throw new Error('SVG element not found');
        }

        await downloadAsPng({
          svgElement,
          width,
          filename: `isologo_${width}px.png`,
        });
      } catch (error) {
        console.error('Error downloading PNG:', error);
      }
    });
  });
</script>
