---
import '@fontsource-variable/inter';
import '@fontsource-variable/work-sans';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Work Sans Variable';

    --aw-color-primary: rgb(82 160 160);

    --aw-color-secondary: rgb(27 109 105);
    --aw-color-accent: rgb(146 207 208);

    --aw-color-text-heading: rgb(30 40 40);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(30 40 40);

    ::selection {
      background-color: rgb(215 232 231);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Work Sans Variable';

    --aw-color-primary: rgb(82 160 160);

    --aw-color-secondary: rgb(27 109 105);
    --aw-color-accent: rgb(146 207 208);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(30 40 40);

    ::selection {
      background-color: rgb(30 40 40);
      color: rgb(231 239 239);
    }
  }
</style>
