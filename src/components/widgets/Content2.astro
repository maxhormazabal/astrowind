---
import type { Content } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import FlowDiagram from '~/components/ui/FlowDiagram.astro';
import type { FlowItem } from '~/components/ui/FlowDiagram.astro';

interface Props extends Content {}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  items = [],
  isReversed = false,
  isAfterContent = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Transform items for the FlowDiagram ensuring they match the FlowItem interface
const flowItems: FlowItem[] = items.map(({ title: itemTitle, description, cardTitle, cardTagline }) => ({
  title: itemTitle || '',
  description: description || '',
  cardTitle: cardTitle || itemTitle || '',
  cardTagline: cardTagline || '',
}));
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="mx-auto max-w-7xl p-4 md:px-8">
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16`}>
      <div class="md:basis-1/2 self-center">
        {content && <div class="mb-12 text-lg dark:text-slate-400" set:html={content} />}

        {
          items && items.length > 0 && (
            <div class="space-y-8">
              {items.map(({ title: itemTitle, description }, index) => (
                <div class={`flow-text-item flow-text-${index} transition-all duration-200`}>
                  <div class="flex">
                    <div class="flex-grow">
                      <h3 class="text-xl font-bold">{itemTitle}</h3>
                      {description && <p class="mt-2 text-muted dark:text-slate-400">{description}</p>}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <div class="md:basis-1/2 flex justify-center items-center mt-8 md:mt-0">
        <div class="w-full max-w-[500px] aspect-square">
          <FlowDiagram items={flowItems} width={500} radius={180} startAngle={-90} />
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>

<style>
  .flow-text-item {
    opacity: 0.7;
    transform: scale(1);
  }

  .flow-text-item.active {
    opacity: 1;
    transform: scale(1.02);
  }

  /* Ensure the diagram maintains aspect ratio on smaller screens */
  @media (max-width: 768px) {
    .aspect-square {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>

<script>
  // Handle flow diagram highlighting
  document.addEventListener('flowHighlight', (event) => {
    const { index } = (event as CustomEvent).detail;

    // Remove active class from all items
    document.querySelectorAll('.flow-text-item').forEach((item) => {
      item.classList.remove('active');
    });

    // Add active class to current item
    document.querySelector(`.flow-text-${index}`)?.classList.add('active');
  });
</script>
