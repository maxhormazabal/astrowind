---
import type { Content } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import FlowDiagram from '~/components/ui/FlowDiagram.astro';
import type { FlowItem } from '~/components/ui/FlowDiagram.astro';

interface Props extends Content {}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  items = [],
  isReversed = false,
  isAfterContent = false,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Transform items for the FlowDiagram ensuring they match the FlowItem interface
const flowItems: FlowItem[] = items.map(({ title: itemTitle, description, cardTitle, cardTagline }) => ({
  title: itemTitle || '',
  description: description || '',
  cardTitle: cardTitle || itemTitle || '',
  cardTagline: cardTagline || '',
}));
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl',
      title: 'text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading',
      subtitle: 'max-w-3xl mx-auto sm:text-center text-xl text-muted dark:text-slate-400',
    }}
  />
  <div class="mx-auto max-w-7xl p-4 md:px-8">
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16`}>
      <div class="md:basis-1/2 self-center">
        {content && <div class="mb-12 text-lg dark:text-slate-400" set:html={content} />}

        {
          items && items.length > 0 && (
            <div class="space-y-8 relative">
              {/* Contenedor destacado que se moverá */}
              <div class="spotlight-container absolute left-0 right-0" />

              {items.map(({ title: itemTitle, description }, index) => (
                <div class={`flow-text-item flow-text-${index} relative p-6 rounded-lg`}>
                  <div class="flex relative z-10">
                    <div class="flex-grow">
                      <h3 class="text-xl font-bold transition-all duration-500">{itemTitle}</h3>
                      {description && (
                        <p class="mt-2 text-muted dark:text-slate-400 transition-all duration-500">{description}</p>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <div class="md:basis-1/2 flex justify-center items-center mt-8 md:mt-0">
        <div class="w-full max-w-[500px] aspect-square">
          <FlowDiagram items={flowItems} width={500} radius={100} startAngle={-90} />
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>

<style>
  .flow-text-item {
    opacity: 0.7;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: left center;
  }

  .flow-text-item.active {
    opacity: 1;
  }

  .spotlight-container {
    background: var(--aw-color-bg-page);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    border-radius: 0.5rem;
    pointer-events: none;
    transition-property: transform, height, opacity;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
  }

  .spotlight-container.visible {
    opacity: 1;
  }

  :global(.dark) .spotlight-container {
    background: var(--aw-color-bg-page-dark);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.2),
      0 2px 4px -2px rgb(0 0 0 / 0.2);
  }

  /* Ensure the diagram maintains aspect ratio on smaller screens */
  @media (max-width: 768px) {
    .aspect-square {
      max-width: 400px;
      margin: 0 auto;
    }
  }
</style>

<script>
  function calculateTransitionDuration(distance: number): number {
    // Base duration for short distances
    const baseDuration = 400;
    // Additional duration based on distance (max 200ms additional)
    const additionalDuration = Math.min(Math.abs(distance) * 0.5, 200);
    return baseDuration + additionalDuration;
  }

  // Handle flow diagram highlighting
  document.addEventListener('flowHighlight', (event) => {
    const { index } = (event as CustomEvent).detail;
    const items = document.querySelectorAll('.flow-text-item');
    const spotlight = document.querySelector('.spotlight-container') as HTMLElement;

    // Remove active class from all items
    items.forEach((item) => {
      item.classList.remove('active');
    });

    // Add active class to current item
    const activeItem = document.querySelector(`.flow-text-${index}`) as HTMLElement;
    if (activeItem && spotlight) {
      activeItem.classList.add('active');

      const itemRect = activeItem.getBoundingClientRect();
      const parentRect = activeItem.parentElement?.getBoundingClientRect();

      if (parentRect) {
        const currentTop = spotlight.style.transform
          ? parseInt(spotlight.style.transform.match(/translateY\(([-\d.]+)px\)/)?.[1] || '0')
          : 0;

        const relativeTop = itemRect.top - parentRect.top;
        const distance = relativeTop - currentTop;

        // Calculate dynamic duration based on distance
        const duration = calculateTransitionDuration(distance);

        // Ensure spotlight is visible
        spotlight.classList.add('visible');

        // Apply dynamic transition duration
        spotlight.style.transitionDuration = `${duration}ms`;
        spotlight.style.transform = `translateY(${relativeTop}px)`;
        spotlight.style.height = `${itemRect.height}px`;
      }
    }
  });

  // Initial setup
  const spotlight = document.querySelector('.spotlight-container') as HTMLElement;
  const firstItem = document.querySelector('.flow-text-item') as HTMLElement;
  if (spotlight && firstItem) {
    const rect = firstItem.getBoundingClientRect();
    spotlight.style.height = `${rect.height}px`;
    spotlight.style.transform = 'translateY(0)';

    // Short delay before showing spotlight initially
    setTimeout(() => {
      spotlight.classList.add('visible');
    }, 100);
  }
</script>
