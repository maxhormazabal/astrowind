---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Pricing as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  prices = [],
  visibleItems = 2, // Número de elementos visibles por defecto

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="flex items-stretch justify-center w-full">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 dark:text-white w-full">
      {
        prices &&
          prices.map(({ title, subtitle, price, period, items, callToAction, hasRibbon = false, ribbonTitle }) => (
            <div class="mx-auto flex w-full intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
              {period && (
                <div class="rounded-lg backdrop-blur border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow px-6 py-8 flex w-full max-w-sm flex-col justify-between text-center transition-all duration-300 hover:shadow-lg hover:scale-105 hover:z-10">
                  {hasRibbon && ribbonTitle && (
                    <div class="absolute right-[-5px] 2xl:right-[-8px] rtl:right-auto rtl:left-[-8px] rtl:2xl:left-[-10px] top-[-5px] 2xl:top-[-10px] z-[1] h-[100px] w-[100px] overflow-hidden text-right">
                      <span class="absolute top-[19px] right-[-21px] rtl:right-auto rtl:left-[-21px] block w-full rotate-45 rtl:-rotate-45 bg-green-700 text-center text-[10px] font-bold uppercase leading-5 text-white shadow-[0_3px_10px_-5px_rgba(0,0,0,0.3)] before:absolute before:left-0 before:top-full before:z-[-1] before:border-[3px] before:border-r-transparent before:border-b-transparent before:border-l-green-800 before:border-t-green-800 before:content-[''] after:absolute after:right-0 after:top-full after:z-[-1] after:border-[3px] after:border-l-transparent after:border-b-transparent after:border-r-green-800 after:border-t-green-800 after:content-[''] ribbon-badge">
                        {ribbonTitle}
                      </span>
                    </div>
                  )}
                  <div class="px-2 py-0 flex flex-col flex-1">
                    {title && (
                      <h3 class="text-center text-xl font-semibold uppercase leading-6 tracking-wider mb-2">{title}</h3>
                    )}
                    <div class="subtitle-container">
                      {subtitle && <p class="font-light sm:text-lg text-gray-600 dark:text-slate-400">{subtitle}</p>}
                    </div>
                    <div class="my-8 flex-grow-0">
                      <div class="flex items-center justify-center text-center mb-1">
                        {price !== '' && (
                          <>
                            <span class="text-5xl">€</span>
                            <span class="text-6xl font-extrabold">{price}</span>
                          </>
                        )}
                      </div>
                      <span class="text-base leading-6 lowercase text-gray-600 dark:text-slate-400">{period}</span>
                    </div>
                    {items && (
                      <div class="flex-grow">
                        <ul
                          class="my-8 md:my-10 space-y-2 text-left pricing-items"
                          id={`plan-items-${title?.toLowerCase().replace(/\s+/g, '-')}`}
                        >
                          {items.map(
                            ({ description, icon }, index) =>
                              description && (
                                <li
                                  class={`mb-1.5 flex items-start space-x-3 leading-7 ${
                                    index >= visibleItems ? 'hidden item-hidden' : 'visible-item'
                                  }`}
                                >
                                  <div class="rounded-full bg-primary mt-1">
                                    <Icon
                                      name={icon ? icon : 'tabler:check'}
                                      class="w-5 h-5 font-bold p-1 text-white"
                                    />
                                  </div>
                                  <span>{description}</span>
                                </li>
                              )
                          )}
                        </ul>
                        {items.length > visibleItems && (
                          <button
                            class="toggle-items text-sm font-medium text-primary flex items-center mx-auto hover:text-secondary"
                            data-target={`plan-items-${title?.toLowerCase().replace(/\s+/g, '-')}`}
                            data-expanded="false"
                            type="button"
                          >
                            <span class="toggle-text">See more</span>
                            <Icon name="tabler:chevron-down" class="toggle-icon w-5 h-5 transition-transform" />
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                  {callToAction && (
                    <div class={`flex justify-center mt-6`}>
                      {typeof callToAction === 'string' ? (
                        <Fragment set:html={callToAction} />
                      ) : (
                        callToAction &&
                        callToAction.href && (
                          <Button
                            {...(hasRibbon ? { variant: 'primary' } : {})}
                            {...callToAction}
                            class="transition-transform hover:scale-105"
                          />
                        )
                      )}
                    </div>
                  )}
                </div>
              )}
            </div>
          ))
      }
    </div>
  </div>
</WidgetWrapper>

<style>
  .rotate-180 {
    transform: rotate(180deg);
  }

  /* Ajustamos alturas mínimas para garantizar alineación */
  .pricing-items {
    min-height: 12rem; /* Altura mínima para desktop */
  }

  @media (max-width: 768px) {
    .pricing-items {
      min-height: auto; /* En móvil permitimos altura natural */
    }
  }

  /* Altura fija para subtítulos en todos los planes */
  .subtitle-container {
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Animación para la etiqueta destacado */
  .ribbon-badge {
    animation: ribbonPulse 2s infinite;
  }

  @keyframes ribbonPulse {
    0% {
      box-shadow: 0 0 0 0 rgba(21, 128, 61, 0.4);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(21, 128, 61, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(21, 128, 61, 0);
    }
  }

  /* Animaciones para mostrar y ocultar elementos */
  .toggle-items {
    position: relative;
    transition: all 0.3s ease;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
  }

  .toggle-items:hover {
    transform: translateY(-2px);
    background-color: rgba(0, 0, 0, 0.03);
  }

  .dark .toggle-items:hover {
    background-color: rgba(255, 255, 255, 0.05);
  }

  .toggle-icon {
    transition: transform 0.5s ease;
  }

  /* Animación para los elementos siempre visibles */
  .visible-item {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  /* Efecto hover para los elementos */
  .pricing-items li:hover {
    transform: translateX(3px);
    color: var(--aw-color-primary);
  }

  /* Animaciones más suaves para los elementos de lista */
  .pricing-items li {
    opacity: 1;
    max-height: 100px;
    transform: translateY(0);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.3, 0.7, 0.4, 1.5);
  }

  .pricing-items li.hidden {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0 !important;
    transform: translateY(-10px);
  }
</style>

<script is:inline define:vars={{ visibleItems }}>
  // Textos traducidos para los botones
  const texts = {
    more: 'See more',
    less: 'See less',
  };

  // Script para expandir/colapsar los elementos usando delegación de eventos
  function handleToggleClick(event) {
    // Verificar si el click fue en un botón toggle o sus hijos
    const button = event.target.closest('.toggle-items');
    if (!button) return;

    event.preventDefault();

    const isExpanded = button.getAttribute('data-expanded') === 'true';
    const newState = !isExpanded;

    // Aplicar un ligero feedback visual al botón
    button.style.transform = 'scale(0.95)';
    setTimeout(() => {
      button.style.transform = '';
    }, 150);

    // Actualizar todos los botones y listas al mismo estado
    document.querySelectorAll('.toggle-items').forEach((btn) => {
      btn.setAttribute('data-expanded', newState.toString());
      const text = btn.querySelector('.toggle-text');
      const icon = btn.querySelector('.toggle-icon');

      if (text) {
        text.textContent = newState ? texts.less : texts.more;
      }

      if (icon) {
        if (newState) {
          icon.classList.add('rotate-180');
        } else {
          icon.classList.remove('rotate-180');
        }
      }
    });

    // Función para animar elementos ocultos - con un enfoque más suave
    document.querySelectorAll('.item-hidden').forEach((item, index) => {
      if (newState) {
        // Antes de mostrar, preparamos el elemento
        item.style.transition = 'all 0.4s cubic-bezier(0.3, 0.7, 0.4, 1.5)';
        item.style.opacity = '0';
        item.style.transform = 'translateY(-10px)';
        item.style.maxHeight = '0';

        // Lo sacamos de hidden para que sea afectado por las transiciones
        item.classList.remove('hidden');

        // Aplicamos un timeout muy pequeño para asegurar que el navegador procese el cambio
        setTimeout(
          () => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
            item.style.maxHeight = '100px';
          },
          20 + index * 30
        );
      } else {
        // Animación para ocultar
        item.style.transition = 'all 0.4s cubic-bezier(0.3, 0.7, 0.4, 1.5)';
        item.style.opacity = '0';
        item.style.transform = 'translateY(-10px)';
        item.style.maxHeight = '0';

        // Una vez completada la animación, añadimos hidden para ocultar del flujo
        setTimeout(() => {
          item.classList.add('hidden');
        }, 400);
      }
    });

    // Dar un efecto sutil a los elementos ya visibles
    if (document.querySelectorAll('.visible-item').length > 0) {
      document.querySelectorAll('.visible-item').forEach((item, index) => {
        item.style.transform = 'translateY(5px)';
        setTimeout(
          () => {
            item.style.transform = 'translateY(0)';
          },
          150 + index * 50
        );
      });
    }
  }

  // Función para configurar la delegación de eventos
  function setupPricingToggles() {
    // Limpiar eventos anteriores para evitar duplicados
    document.body.removeEventListener('click', handleToggleClick);

    // Usar delegación de eventos a nivel del body para mejor rendimiento
    document.body.addEventListener('click', handleToggleClick);

    // Asegurar que los elementos comienzan en el estado correcto
    document.querySelectorAll('.toggle-items').forEach((btn) => {
      btn.setAttribute('data-expanded', 'false');
      const text = btn.querySelector('.toggle-text');
      if (text) text.textContent = texts.more;
    });

    // Animación inicial para los elementos visibles - más sutil y elegante
    document.querySelectorAll('.visible-item').forEach((item, index) => {
      item.style.opacity = '0';
      item.style.transform = 'translateY(10px)';

      // Efecto de entrada escalonado para cada elemento
      setTimeout(
        () => {
          item.style.transition = 'opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)';
          item.style.opacity = '1';
          item.style.transform = 'translateY(0)';
        },
        100 + index * 80
      );
    });
  }

  // Función que se ejecuta cuando el DOM está listo
  function onDOMReady() {
    setupPricingToggles();
  }

  // Inicializar de varias maneras para cubrir todos los casos
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', onDOMReady);
  } else {
    onDOMReady();
  }

  // También inicializar cuando Astro carga una nueva página (navegación del lado del cliente)
  document.addEventListener('astro:page-load', setupPricingToggles);

  // Cuando Astro se prepara para cambiar de página
  document.addEventListener('astro:before-swap', () => {
    // Limpiar los listeners para evitar duplicados
    document.body.removeEventListener('click', handleToggleClick);
  });
</script>
