---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import Image from '~/components/common/Image.astro';

// Importar las imágenes directamente
import logoWhite from '~/assets/logos/gain_white.svg';
import logoBlack from '~/assets/logos/gain_white.svg';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;
---

<footer class="dark:bg-[#030621] bg-[#1B1F22] text-white py-12 not-prose">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Logo y texto de proyecto -->
      <div class="flex flex-col">
        <div class="mb-4">
          <!-- Logo para modo oscuro (visible solo en modo oscuro) -->
          <img
            src={logoWhite.src}
            alt="Dokken Logo"
            class="h-16 w-auto object-contain hidden dark:block"
            width={logoWhite.width}
            height={logoWhite.height}
          />
          <!-- Logo para modo claro (visible solo en modo claro) -->
          <img
            src={logoBlack.src}
            alt="Dokken Logo"
            class="h-16 w-auto object-contain dark:hidden"
            width={logoBlack.width}
            height={logoBlack.height}
          />
        </div>
        <p class="text-sm mt-2 text-gray-300" set:html={footNote} />
      </div>

      <!-- Enlaces legales -->
      {
        links.map(({ title, links }) => (
          <div>
            <h3 class="text-lg font-semibold mb-4">{title}</h3>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-3">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-gray-300 hover:text-white transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                      set:html={text}
                    />
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }

      <!-- Contacto y redes sociales -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contáctenos</h3>
        <ul class="space-y-3">
          {
            links
              .filter((section) => section.title === 'Contáctenos')[0]
              ?.links.map(({ text }) => <li class="text-gray-300" set:html={text} />)
          }
        </ul>

        <!-- Redes sociales -->
        <div class="flex space-x-4 mt-6">
          {
            socialLinks?.length &&
              socialLinks.map(({ ariaLabel, href, icon }) => (
                <a
                  class="text-gray-400 hover:text-white transition duration-150 ease-in-out"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                </a>
              ))
          }
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-700 mt-10 pt-6 text-center text-sm text-gray-400">
      © {new Date().getFullYear()} Dokken. Todos los derechos reservados.
    </div>
  </div>
</footer>
