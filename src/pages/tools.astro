---
import type { MetaData } from '~/types';
import PageLayout from '~/layouts/PageLayout.astro';
import DownloadLogo from '~/components/tools/DownloadLogo.astro';
import DownloadIsoLogo from '~/components/tools/DownloadIsoLogo.astro';
import DownloadEntireLogo from '~/components/tools/DownloadEntireLogo.astro';

const metadata: MetaData = {
  title: 'Herramientas Corporativas',
  description: 'Recursos y herramientas para el equipo',
};

// Opciones de ancho predefinidas para el PNG
const widthOptions = [256, 512, 1024, 2048];

// Colores predeterminados y opciones
const textColorOptions = [
  { value: '#f9f9f9', label: 'Blanco' },
  { value: '#1E2828', label: 'Negro' },
];

const logoColorOptions = [
  { value: '#1E2828', label: 'Negro' },
  { value: '#1C4B49', label: 'Verde Oscuro' },
  { value: '#1A6D69', label: 'Verde' },
  { value: '#57A09F', label: 'Verde Medio' },
  { value: '#93D3D4', label: 'Verde Agua' },
  { value: '#A6DBDC', label: 'Verde Claro' },
  { value: '#D6EEEF', label: 'Verde Muy Claro' },
  { value: '#E6F4F4', label: 'Verde Pálido' },
];

const defaultTextColor = '#f9f9f9';
const defaultLogoColor = '#b1dbea';
---

<PageLayout metadata={metadata}>
  <section class="relative dark">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute inset-0 bg-slate-900"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
      <div class="py-12 md:py-20">
        <div class="text-center pb-10 md:pb-16 max-w-5xl mx-auto">
          <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter mb-4 font-heading text-white">
            Herramientas Corporativas
          </h1>
          <div class="max-w-3xl mx-auto">
            <p class="text-xl text-slate-300">Recursos y herramientas para el equipo</p>
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 my-12">
          <DownloadLogo />
          <DownloadIsoLogo />
          <DownloadEntireLogo />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
