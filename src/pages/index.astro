---
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Dokken — Intelligent Document Processing Platform',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <div class="bg-blue-600 min-h-screen pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="py-12 md:py-20 text-center">
        <!-- Main Heading -->
        <div class="pb-10 md:pb-16 max-w-4xl mx-auto">
          <h1 class="text-5xl md:text-6xl xl:text-7xl font-bold leading-tight tracking-tight mb-8 text-white">
            <span class="block">Efficient Docs,</span>
            <span class="block">Not Paperwork</span>
          </h1>

          <div class="text-center max-w-3xl mx-auto">
            <p class="text-xl text-white mb-6">
              Transform your document processing with <span class="font-semibold">AI-powered extraction</span>,
              <span class="font-semibold">automated validation</span>, and
              <span class="font-semibold">custom workflows</span>.
            </p>
            <p class="text-lg text-blue-100 mb-12">
              Perfect for businesses processing more than 1,000 documents monthly.
            </p>

            <!-- Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a
                href="#"
                class="inline-flex items-center justify-center bg-white hover:bg-gray-100 text-blue-600 font-medium py-3 px-8 rounded-full"
              >
                Book A Demo
              </a>
              <a
                href="#"
                class="inline-flex items-center justify-center border border-white hover:bg-blue-700 text-white font-medium py-3 px-8 rounded-full"
              >
                Learn More
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Before/After Demo Section -->
      <div class="max-w-5xl mx-auto mt-8 pb-20">
        <div class="relative bg-white rounded-xl overflow-hidden shadow-xl p-8">
          <div class="flex flex-col md:flex-row justify-between">
            <div class="w-full md:w-1/2 p-4 border-r border-gray-200">
              <div class="flex items-center mb-4">
                <div class="h-6 w-6 rounded-full border border-gray-300 flex items-center justify-center mr-2">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-gray-500"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-gray-600 font-medium">Manual Processing</span>
              </div>
              <div class="text-gray-400 mt-6">
                <p class="mb-3">• Hours spent manually extracting data</p>
                <p class="mb-3">• High error rates (15-20%)</p>
                <p class="mb-3">• Complex validation workflows</p>
                <p class="mb-3">• Multiple people involved in approvals</p>
                <p class="mb-3">• Average processing time: 15 min/doc</p>
              </div>
            </div>
            <div class="w-full md:w-1/2 p-4">
              <div class="flex items-center mb-4">
                <div
                  class="h-6 w-6 rounded-full border border-blue-500 bg-blue-500 flex items-center justify-center mr-2"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-white"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-blue-600 font-medium">Dokken IDP</span>
              </div>
              <div class="text-gray-800 mt-6">
                <p class="mb-3">• Automated data extraction with 99% accuracy</p>
                <p class="mb-3">• Error reduction to less than 2%</p>
                <p class="mb-3">• Automated business rule validation</p>
                <p class="mb-3">• Streamlined approval workflows</p>
                <p class="mb-3">• Average processing time: 30 sec/doc</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Widget *************** -->
  <Features
    id="features"
    tagline="Our Platform"
    title="End-to-End Intelligent Document Processing"
    subtitle="Automate the entire document lifecycle, from capture to validation and storage, reducing errors and saving time."
    items={[
      {
        title: 'Intelligent Extraction',
        description:
          'Advanced OCR and NLP technology to capture text and structured fields from invoices, contracts, reports, and more.',
        icon: 'tabler:brain',
      },
      {
        title: 'Business Rules Validation',
        description:
          'Configurable engine that verifies duplicates, ranges, field consistency, and internal policies automatically.',
        icon: 'tabler:check',
      },
      {
        title: 'Data Integration',
        description:
          'Seamless connection with internal databases, ERPs and CRMs to enrich and complete missing information.',
        icon: 'tabler:database',
      },
      {
        title: 'Custom Workflows',
        description:
          'Automatic flow of notifications, approvals, alerts, and routing to downstream systems based on your needs.',
        icon: 'tabler:route',
      },
      {
        title: 'Deployment Options',
        description:
          'Choose between Hybrid setup for large enterprises or lightweight SaaS for quick onboarding and SMEs.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Security & Compliance',
        description:
          'Enterprise-grade security with encryption, access controls, and audit trails to keep your documents safe.',
        icon: 'tabler:lock',
      },
    ]}
  />

  <!-- Why Dokken Section -->
  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Choose Dokken?</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Our platform stands out from competitors with key differentiators that deliver real business impact.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-lg shadow-md">
          <div class="flex items-start mb-4">
            <div class="bg-blue-100 p-3 rounded-full mr-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">True End-to-End Solution</h3>
              <p class="text-gray-600">
                We don't just extract data; we handle the complete document journey through validation, enrichment, and
                integration with your systems.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <div class="flex items-start mb-4">
            <div class="bg-blue-100 p-3 rounded-full mr-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Native Business Rules Validation</h3>
              <p class="text-gray-600">
                Configure complex validation rules without additional development, ensuring data integrity from day one.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <div class="flex items-start mb-4">
            <div class="bg-blue-100 p-3 rounded-full mr-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">System Integration</h3>
              <p class="text-gray-600">
                Automatic connection with your internal systems completes and verifies data without manual intervention.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-md">
          <div class="flex items-start mb-4">
            <div class="bg-blue-100 p-3 rounded-full mr-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-blue-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                ></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold mb-2">Scientific-Tech Team</h3>
              <p class="text-gray-600">
                Our own R&D team continuously improves our AI models, ensuring you always have cutting-edge technology.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-blue-600 py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Ready to Transform Your Document Processing?</h2>
      <p class="text-xl text-blue-100 mb-10 max-w-3xl mx-auto">
        Join the companies that save over 30 hours per week and reduce document processing costs by up to 70%.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#"
          class="inline-flex items-center justify-center bg-white hover:bg-gray-100 text-blue-600 font-medium py-3 px-8 rounded-full"
        >
          Schedule a Demo
        </a>
        <a
          href="#"
          class="inline-flex items-center justify-center border border-white hover:bg-blue-700 text-white font-medium py-3 px-8 rounded-full"
        >
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .font-handwriting {
    font-family: 'Segoe Script', 'Brush Script MT', cursive;
  }
</style>
