---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Content2 from '~/components/widgets/Content2.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'Dokken — Document Processing Platform',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Book a demo',
        href: '#',
        target: '_blank',
        icon: 'tabler:calendar',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    lightImage={{ src: '~/assets/images/hero/laptop_black.png', alt: 'Hero Image - Light Mode' }}
    darkImage={{ src: '~/assets/images/hero/laptop_white.png', alt: 'Hero Image - Dark Mode' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Efficient Documents</span>: Manage your documents from start to finish
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Dokken</span> transforms document processing with AI: extraction, automatic validation
        through business rules, and fully configurable workflows.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">
        Dokken: intelligent documents, optimized processes.
      </span>
      Perfect for SMEs and large companies looking to save time, reduce errors, and automate document workflows.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <!-- <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" /> -->

  <!-- Content Widget **************** -->

  <Content2
    id="how-it-works"
    tagline="How it works"
    title="Transform your document processing"
    subtitle="Our powerful platform streamlines your document workflow in three simple steps"
    items={[
      {
        title: 'Smart Extraction',
        description: 'Our AI-powered system extracts key information from any document type with high accuracy.',
        cardTitle: 'AI-Powered',
        cardTagline: 'Meaningful information from unstructured data',
      },
      {
        title: 'Automated Processing',
        description: 'Business rules and validation ensure data quality and compliance at every step.',
        cardTitle: 'Rules & Validation',
        cardTagline: 'Automate your business process, applying rules and validations',
      },
      {
        title: 'Seamless Integration',
        description: 'Connect with your existing tools and systems for a smooth, efficient workflow.',
        cardTitle: 'Connect & Share',
        cardTagline: 'Present the right data into your ERP, CRM or IT tools',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content2>

  <!-- Interactive Content Widget *************** -->

  <Content
    tagline="How It Works"
    title="Four Steps to Intelligent Document Processing"
    isInteractive={true}
    items={[
      {
        title: 'Ingest from Any Source',
        description:
          'Capture documents from multiple origins to automatically extract meaningful information with our system.',
        // callToAction: {
        //   text: 'View Details',
        //   href: '#',
        //   icon: 'tabler:arrow-right',
        // },
      },
      {
        title: 'Data Enrichment',
        description:
          'Look up information in databases and reference systems, or define your own business rules to enhance extracted data.',
      },
      {
        title: 'Human-in-the-Loop Validation',
        description: 'Allow reviewers to verify the results and make the final decision.',
      },
      {
        title: 'Export Wherever You Need',
        description: 'Deliver validated data to your ERP or CRM, or export to the most used applications.',
      },
    ]}
    images={[
      {
        src: '~/assets/images/steps/1.png',
        alt: 'Ingest from Any Source',
      },
      {
        src: '~/assets/images/steps/2.png',
        alt: 'Data Enrichment',
      },
      {
        src: '~/assets/images/steps/3.png',
        alt: 'Human-in-the-Loop Validation',
      },
      {
        src: '~/assets/images/steps/4.png',
        alt: 'Export Wherever You Need',
      },
    ]}
  />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="What you get with Dokken"
    subtitle="One of the most professional and comprehensive solutions for document processing in today's market."
    items={[
      {
        title: 'Enterprise System Integration',
        description:
          'Seamless integration with ERPs, CRMs and other business systems for continuous flow of data and documents.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Ready-to-Use Components',
        description:
          'Tools designed for use in business environments, accounting departments, administrative and document management.',
        icon: 'tabler:components',
      },
      {
        title: 'Best Practices',
        description:
          'Creating secure, efficient and user-friendly solutions that provide exceptional experiences and lasting value.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Excellent Processing Speed',
        description:
          'Good processing speed improves productivity, optimizes user experience and increases adoption rates.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Workflow Optimization',
        description:
          'Workflow optimization improves process visibility, drives efficiency and enables you to reach more customers.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Open to New Ideas and Contributions',
        description:
          'We embrace a culture open to new ideas and contributions that fosters innovation, collaboration and a dynamic user experience.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    tagline="measurable results"
    subtitle="You don't have to wait long to see the results. With Dokken, you can see the time reduction in a few days"
    stats={[
      { title: 'Average reduction in manual effort per task', amount: '88.3%' },
      { title: 'Median improvement over a 6-month payback period', amount: '3.5x' },
      { title: 'Faster configuration time compared to the industry standard', amount: '4x' },
    ]}
  />

  <!-- Pricing Widget **************** -->

  <Pricing
    id="pricing"
    title="Pricing plans tailored to your needs"
    subtitle="Choose the plan that best fits your business"
    visibleItems={2}
    defaultPeriod="monthly"
    showToggle={true}
    hide_links={true}
    monthlyBillingText="Billed monthly"
    yearlyBillingText="Billed annually"
    prices={[
      {
        title: 'Free',
        subtitle: 'For individuals and small projects',
        priceMonthly: '0',
        priceYearly: '0',
        period: '-',
        items: [
          {
            description: 'Process up to 50 pages/month',
          },
          {
            description: 'Admin access only',
          },
          {
            description: '1 month license',
          },
          {
            description: 'Limited use',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
      {
        title: 'Business',
        subtitle: 'For growing companies',
        priceMonthly: 225,
        priceYearly: 195,
        period: '-',
        items: [
          {
            description: 'Process up to 500 pages/month',
          },
          {
            description: 'Admin + access for 5 users',
          },
          {
            description: 'Advanced text and data extraction',
          },
          {
            description: 'Business rules definition (limited)',
          },
          {
            description: 'Email support 8 hours / 5 days',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'featured',
      },
      {
        title: 'Professional',
        subtitle: 'For professional users',
        priceMonthly: 525,
        priceYearly: 495,
        period: '-',
        items: [
          {
            description: 'Process up to 2000 pages/month',
          },
          {
            description: 'Admin + access for 30 users',
          },
          {
            description: 'Complete suite of extraction tools',
          },
          {
            description: 'Basic connectors for ERP, CRM and other business tools',
          },
          {
            description: 'Complete business rules definition',
          },
          {
            description: 'Support 24 hours / 7 days',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
      {
        title: 'Enterprise',
        subtitle: 'For large organizations',
        priceMonthly: '-',
        priceYearly: '-',
        period: '-',
        items: [
          {
            description: 'White-label platform with unlimited users and pages access',
          },
          {
            description: 'Setup + Annual license',
          },
          {
            description: 'Complete suite of extraction tools',
          },
          {
            description: 'Wide variety of IT tool connectors',
          },
          {
            description: 'Custom features and AI model training',
          },
          {
            description: 'Complete business rules definition and validation',
          },
          {
            description: 'Premium support 24/7',
          },
          {
            description: 'Dedicated account manager',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
    ]}
  />

  <!-- Brands Widget ****************** -->

  <Brands
    id="integrations"
    title="Integrations & Connections"
    subtitle="Enrich your documents with powerful integrations that allow you to import data or export to multiple platforms, enhancing your document management experience."
    icons={[]}
    images={[
      {
        src: '~/assets/images/integrations/postgresql_black.svg',
        alt: 'PostgreSQL',
        href: 'https://www.postgresql.org/',
      },
      {
        src: '~/assets/images/integrations/mysql_black.svg',
        alt: 'MySQL',
        href: 'https://www.mysql.com/',
      },
      {
        src: '~/assets/images/integrations/sage_black.svg',
        alt: 'Sage',
        href: 'https://www.sage.com/',
      },
      {
        src: '~/assets/images/integrations/salesforce_black.svg',
        alt: 'Salesforce',
        href: 'https://www.salesforce.com/',
      },
      {
        src: '~/assets/images/integrations/googledrive_black.svg',
        alt: 'Google Drive',
        href: 'https://www.google.com/drive/',
      },
      {
        src: '~/assets/images/integrations/odoo_black.svg',
        alt: 'Odoo',
        href: 'https://www.odoo.com/',
      },
      {
        src: '~/assets/images/integrations/gmail_black.svg',
        alt: 'Gmail',
        href: 'https://mail.google.com/',
      },
      {
        src: '~/assets/images/integrations/dropbox_black.svg',
        alt: 'Dropbox',
        href: 'https://www.dropbox.com/',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faq"
    title="Frequently Asked Questions"
    subtitle="Explore the following questions to learn about the powerful features Dokken offers and how it can improve your document management."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why choose Dokken?',
        description:
          'Dokken offers a complete solution for document management with artificial intelligence, allowing you to automate processes, reduce errors and save valuable time in your business.',
      },
      {
        title: 'What do I need to get started?',
        description:
          'You only need your documents and a clear idea of your business processes. We take care of configuring the system according to your specific needs.',
      },
      {
        title: 'How is Dokken installed?',
        description:
          'Dokken is a cloud-based solution, so it requires no installation. Simply access through your web browser and start using it immediately.',
      },
      {
        title: 'What types of documents can it process?',
        description:
          'Dokken can process virtually any type of document: invoices, delivery notes, contracts, forms, IDs, passports, reports, and much more.',
      },
      {
        title: 'Is it safe to store my documents in Dokken?',
        description:
          'Absolutely. We use end-to-end encryption and comply with all data protection regulations, including European GDPR.',
      },
      {
        title: 'Can I customize workflows according to my needs?',
        description:
          'Yes, Dokken offers fully customizable workflows that adapt to your specific business processes, with configurable validation rules and custom automation.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    id="contact"
    title="Get in touch"
    subtitle="Is Dokken the right solution for you? Contact us to learn more about our features and how we can help your business."
    items={[
      {
        title: 'Email us',
        description: 'info@dokken.ai',
        icon: 'tabler:mail',
        href: 'mailto:info@dokken.ai',
      },
      {
        title: 'Call us',
        description: '+34 677 163 247',
        icon: 'tabler:headset',
        href: 'tel:+34677163247',
      },
      {
        title: 'Follow us',
        description: '@dokken-ai',
        icon: 'tabler:brand-linkedin',
        href: 'https://linkedin.com/company/dokken-ai',
      },
    ]}
  />
  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started Now',
        href: 'https://github.com/onwidget/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Dokken&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Artificial Intelligence</span>
    </Fragment>

    <Fragment slot="subtitle">
      Transform your document management today and join thousands of companies already trusting Dokken. <br
        class="hidden md:inline"
      />
      Stop wasting time with manual processes!
    </Fragment>
  </CallToAction>
</Layout>
