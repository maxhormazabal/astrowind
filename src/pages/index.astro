      {
        src: '~/assets/images/integrations/salesforce_black.svg',
        alt: 'Salesforce',
        href: 'https://www.salesforce.com/',
      },
      {
        src: '~/assets/images/integrations/googledrive_black.svg',
        alt: 'Google Drive',
