---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Brands from '~/components/widgets/Brands.astro';

const metadata = {
  title: 'Dokken — Plataforma de gestión de documentos con inteligencia artificial',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get a demo',
        href: 'https://github.com/onwidget/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
      { text: 'Learn more', href: '#features' },
    ]}
    lightImage={{ src: '~/assets/images/hero/laptop_black.png', alt: 'Hero Image - Light Mode' }}
    darkImage={{ src: '~/assets/images/hero/laptop_white.png', alt: 'Hero Image - Dark Mode' }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Efficient Documents</span>: Manage your documents from start to finish
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Dokken</span> transforms document processing with AI: extraction, automatic validation
        through business rules, and fully configurable workflows.
      </span>
      <span class="block mb-1 sm:hidden font-bold text-blue-600">
        Dokken: intelligent documents, optimized processes.
      </span>
      Perfect for SMEs and large companies looking to save time, reduce errors, and automate document workflows.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Filosofía:" description="Simplicidad, Mejores Prácticas y Alto Rendimiento" />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Inside template"
    title="AstroWind's Blueprint: Fun Meets Functionality!"
    items={[
      {
        title: 'Built on top of Astro 5.0',
        description:
          'Benefiting from the performance and developer-friendly features of this modern static site generator.',
      },
      {
        title: 'Styled using Tailwind CSS',
        description:
          'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.',
      },
      {
        title: 'Cross-browser compatibility',
        description:
          'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Características"
    title="Lo que obtiene con Dokken"
    subtitle="Una de las soluciones más profesionales y completas para el procesamiento de documentos en el mercado actual."
    items={[
      {
        title: 'Integración con Sistemas Empresariales',
        description:
          'Integración perfecta con ERPs, CRMs y otros sistemas empresariales para un flujo continuo de datos y documentos.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'Componentes Listos para Usar',
        description:
          'Herramientas diseñadas para ser utilizadas en entornos empresariales, departamentos contables, administrativos y de gestión documental.',
        icon: 'tabler:components',
      },
      {
        title: 'Mejores Prácticas',
        description:
          'Creación de soluciones seguras, eficientes y fáciles de usar que proporcionan experiencias excepcionales y valor duradero.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Excelente Velocidad de Procesamiento',
        description:
          'Una buena velocidad de procesamiento mejora la productividad, optimiza la experiencia de usuario y aumenta las tasas de adopción.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Optimización para Flujos de Trabajo',
        description:
          'La optimización de flujos de trabajo mejora la visibilidad de sus procesos, impulsa la eficiencia y permite alcanzar a más clientes.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Abierto a nuevas ideas y contribuciones',
        description:
          'Adoptamos una cultura abierta a nuevas ideas y contribuciones que fomenta la innovación, la colaboración y una experiencia de usuario dinámica.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <!-- Interactive Content Widget *************** -->

  <Content
    tagline="Características Avanzadas"
    title="Design pixel-perfect sites beyond ordinary"
    isInteractive={true}
    items={[
      {
        title: 'Advanced typography',
        description:
          'Take full control over your text with precision typography tools. Adjust fonts, spacing, and styles to add more character to your design.',
        callToAction: {
          text: 'View Details',
          href: '#',
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'CSS grids and layouts',
        description:
          'Build complex layouts with ease using CSS Grids. Create multi-directional structures, manage spacing, and achieve perfect alignment without limitations.',
        callToAction: {
          text: 'View Details',
          href: '#',
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Adaptive design',
        description:
          'Create designs that adapt seamlessly to any device or screen size. Ensure optimal user experience from desktop to mobile with responsive frameworks.',
        callToAction: {
          text: 'View Details',
          href: '#',
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Designed for efficiency',
        description:
          'Optimize your workflow with tools designed for speed and efficiency. Automate repetitive tasks and focus on what matters: creating exceptional designs.',
        callToAction: {
          text: 'View Details',
          href: '#',
          icon: 'tabler:arrow-right',
        },
      },
    ]}
    images={[
      {
        src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
        alt: 'Typography showcase',
      },
      {
        src: 'https://images.unsplash.com/photo-1545235617-9465d2a55698?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2080&q=80',
        alt: 'CSS Grids showcase',
      },
      {
        src: 'https://images.unsplash.com/photo-1586717791821-3f44a563fa4c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
        alt: 'Adaptive Design showcase',
      },
      {
        src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
        alt: 'Efficiency showcase',
      },
    ]}
  >
    <Fragment slot="content"> Create stunning websites with our intuitive and powerful design tools </Fragment>
  </Content>

  <!-- Pricing Widget **************** -->

  <Pricing
    title="Pricing plans tailored to your needs"
    subtitle="Choose the plan that best fits your business"
    visibleItems={2}
    defaultPeriod="monthly"
    showToggle={true}
    hide_links={true}
    monthlyBillingText="Billed monthly"
    yearlyBillingText="Billed annually"
    prices={[
      {
        title: 'Free',
        subtitle: 'For individuals and small projects',
        priceMonthly: '0',
        priceYearly: '0',
        period: '-',
        items: [
          {
            description: 'Process up to 50 pages/month',
          },
          {
            description: 'Admin access only',
          },
          {
            description: '1 month license',
          },
          {
            description: 'Limited use',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
      {
        title: 'Business',
        subtitle: 'For growing companies',
        priceMonthly: 225,
        priceYearly: 195,
        period: '-',
        items: [
          {
            description: 'Process up to 500 pages/month',
          },
          {
            description: 'Admin + access for 5 users',
          },
          {
            description: 'Advanced text and data extraction',
          },
          {
            description: 'Business rules definition (limited)',
          },
          {
            description: 'Email support 8 hours / 5 days',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'featured',
      },
      {
        title: 'Professional',
        subtitle: 'For professional users',
        priceMonthly: 525,
        priceYearly: 495,
        period: '-',
        items: [
          {
            description: 'Process up to 2000 pages/month',
          },
          {
            description: 'Admin + access for 30 users',
          },
          {
            description: 'Complete suite of extraction tools',
          },
          {
            description: 'Basic connectors for ERP, CRM and other business tools',
          },
          {
            description: 'Complete business rules definition',
          },
          {
            description: 'Support 24 hours / 7 days',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
      {
        title: 'Enterprise',
        subtitle: 'For large organizations',
        priceMonthly: '-',
        priceYearly: '-',
        period: '-',
        items: [
          {
            description: 'White-label platform with unlimited users and pages access',
          },
          {
            description: 'Setup + Annual license',
          },
          {
            description: 'Complete suite of extraction tools',
          },
          {
            description: 'Wide variety of IT tool connectors',
          },
          {
            description: 'Custom features and AI model training',
          },
          {
            description: 'Complete business rules definition and validation',
          },
          {
            description: 'Premium support 24/7',
          },
          {
            description: 'Dedicated account manager',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Choose plan',
          href: '#',
        },
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'High level of customization',
        description: `Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
      },
      {
        title: 'Multiple layout possibilities',
        description:
          'Explore various layout options to find the structure that best presents your content, enhancing user engagement and navigation.',
      },
      {
        title: 'Fully responsive design',
        description:
          "Ensure your website's optimal performance on various devices and screen sizes, providing a consistent and enjoyable user experience.",
      },
      {
        title: 'Integration of media',
        description:
          'Seamlessly incorporate images, videos, and multimedia elements that enhance your content and engage visitors effectively.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content">Ensure your online presence truly represents you.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Enhanced user engagement',
        description:
          'Captivate your audience with interactive elements, intuitive navigation, and visually appealing layouts, encouraging longer visits.',
      },
      {
        title: 'Continuous improvement',
        description:
          'Ensure your website stays aligned with the latest trends and technologies through regular updates and enhancements.',
      },
      {
        title: 'Time and resource efficiency',
        description:
          'Skip the time-consuming process of building a website from scratch and launch your online presence sooner with AstroWind.',
      },
      {
        title: 'Community support',
        description: `Join the growing AstroWind community for insights, resources, and assistance, ensuring you're never alone on your web development journey.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">Designed to foster growth and success.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Get your dream website up and running in no time with AstroWind."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Download</span>',
        description:
          "Kickstart with GitHub! Either fork the AstroWind template or simply click 'Use this template'. Your canvas awaits, ready for your digital masterpiece. In just a few clicks, you've already set the foundation.",
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: <span class="font-medium">Add content</span>',
        description:
          "Pour your vision into it. Add images, text, and all that jazz to breathe life into your digital space. Remember, it's the content that tells your story, so make it captivating.",
        icon: 'tabler:letter-case',
      },
      {
        title: 'Step 3: <span class="font-medium">Customize styles</span>',
        description:
          'Give it your personal touch. Tailor colors, fonts, and layouts until it feels just right. Your unique flair, amplified by AstroWind! Precision in design ensures a seamless user experience.',
        icon: 'tabler:paint',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Steps image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Most used widgets"
    subtitle="Provides frequently used components for building websites using Tailwind CSS"
    tagline="Components"
    items={[
      {
        title: 'Headers',
        description: "Ever tried driving without GPS? Boom! That's why websites need headers for direction.",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Heros',
        description:
          "Picture a superhero landing – epic, right? That's the job of a Hero section, making grand entrances!",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Features',
        description:
          'Where websites strut their stuff and show off superpowers. No holding back on the bragging rights here!',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Content',
        description:
          "Dive into the meat and potatoes of a site; without it, you'd just be window shopping. Content is king.",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Call-to-Action',
        description:
          'That enthusiastic friend who\'s always urging, "Do it! Do it!"? Yeah, that\'s this button nudging you towards adventure.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Pricing',
        description: 'Behold the dessert menu of the website world. Tempting choices await, can you resist?',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Testimonial',
        description: 'Step into the gossip corner! Here, other visitors spill the beans and share the juicy details.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Contact',
        description:
          'Like a digital mailbox, but faster! Drop a line, ask a question, or send a virtual high-five. Ding! Message in.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Footers',
        description: "The footer's like the credits of a movie but sprinkled with easter eggs. Time to hunt!",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- Brands Widget ****************** -->

  <Brands
    title="Integrations & Connections"
    subtitle="Enrich your documents with powerful integrations that allow you to import data or export to multiple platforms, enhancing your document management experience."
    icons={[]}
    images={[
      {
        src: '~/assets/images/integrations/postgresql_black.svg',
        alt: 'PostgreSQL',
        href: 'https://www.postgresql.org/',
      },
      {
        src: '~/assets/images/integrations/mysql_black.svg',
        alt: 'MySQL',
        href: 'https://www.mysql.com/',
      },
      {
        src: '~/assets/images/integrations/sage_black.svg',
        alt: 'Sage',
        href: 'https://www.sage.com/',
